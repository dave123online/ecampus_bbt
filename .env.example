# ---------------------------------------------------------------------------
# eCampus BBT — variables d'environnement
# Dev local : copier ce fichier en .env puis remplir les valeurs.
# Render    : voir render.yaml (les variables y sont déclarées).
# ---------------------------------------------------------------------------

# --- Django core ---
# DEBUG est OFF par défaut. En local uniquement : DJANGO_DEBUG=1
DJANGO_DEBUG=1
# Obligatoire si DJANGO_DEBUG=0 (le démarrage échoue sinon).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines HTTPS autorisées pour les POST (séparées par des virgules).
# PLATFORM_BASE_URL (si https) est ajoutée automatiquement.
CSRF_TRUSTED_ORIGINS=

# --- Base de données ---
# Render injecte DATABASE_URL (prioritaire). Sinon SQLite, ou Postgres via DB_*.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DJANGO_USE_POSTGRES=0
DB_NAME=english_platform
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- URL publique de la plateforme (sans / final) ---
# Utilisée pour les URLs de callback/webhook des prestataires.
# Sur Render, repli automatique sur RENDER_EXTERNAL_URL.
PLATFORM_BASE_URL=http://127.0.0.1:8000

# --- Médias (PDF / audio uploadés) ---
# Render : /var/data/media (Persistent Disk monté sur /var/data)
# MEDIA_ROOT=/var/data/media

# --- Logs ---
# Console seule par défaut (Render collecte stdout). 1 = fichier logs/ecampus.log
LOG_TO_FILE=0

# --- HTTPS / HSTS (production) ---
SECURE_SSL_REDIRECT=1
# Monter progressivement (3600 -> 31536000) une fois le HTTPS validé.
SECURE_HSTS_SECONDS=3600

# --- File serving derrière Nginx/Apache (inutile sur Render) ---
USE_X_ACCEL_REDIRECT=0
USE_X_SENDFILE=0

# --- Email ---
# Dev : les emails s'affichent dans la console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Prod (SMTP bloqué sur les instances Render Free) :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ecampus-bbt.com

# --- Flutterwave (cartes internationales, y c. prépayées) ---
# Dashboard -> API Keys
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Dashboard -> Webhooks -> "Secret Hash" (à recopier ici)
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# --- KkiaPay (Mobile Money Bénin/UEMOA) ---
# Dashboard KkiaPay -> Développeurs -> Clés d'API (3 clés)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
# Dashboard -> Webhooks : le "hash secret" choisi (renvoyé dans l'en-tête x-kkiapay-secret)
KKIAPAY_WEBHOOK_SECRET=
# 1 = sandbox (widget + API de test, numéros de test KkiaPay) ; 0 = production
KKIAPAY_SANDBOX=1

# --- Paiement fractionné / housekeeping ---
# Part du prix payée en tranche 1 avant premier déverrouillage (0-1)
FIRST_TRANCHE_RATIO=0.34
# Annulation auto des inscriptions jamais payées après N jours
ENROLLMENT_ABANDON_AFTER_DAYS=7
