# ---------------------------------------------------------------------------
# eCampus BBT — variables d'environnement
# Copier ce fichier en .env puis remplir les valeurs.
# ---------------------------------------------------------------------------

# --- Django core ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données (optionnel : Postgres en prod) ---
DJANGO_USE_POSTGRES=0
DB_NAME=english_platform
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- URL publique de la plateforme (sans / final) ---
# Utilisée pour construire les URLs de callback/webhook des prestataires.
# En prod : https://votre-domaine.bj
PLATFORM_BASE_URL=http://127.0.0.1:8000

# --- Flutterwave (cartes internationales, y c. prépayées) ---
# Dashboard → API Keys
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Dashboard → Webhooks → "Secret Hash" (à recopier ici)
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3

# --- KkiaPay (Mobile Money Bénin/UEMOA) ---
KKIAPAY_PUBLIC_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_BASE_URL=https://api.kkiapay.me/api

# --- Paiement fractionné / housekeeping ---
# Part du prix payée en tranche 1 avant premier déverrouillage (0-1)
FIRST_TRANCHE_RATIO=0.34
# Annulation auto des inscriptions jamais payées après N jours
ENROLLMENT_ABANDON_AFTER_DAYS=7
